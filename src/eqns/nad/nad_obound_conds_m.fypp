#:include 'gyre.inc'

#:set P = os.path.basename(_FILE_).split('_')[0]

module ${P}$_nad_obound_conds_m

   ! Uses

   use forum_m, only: RD

   use atmos_m
   use bound_conds_m
   use context_m
   use math_m
   use model_m
   use model_util_m
   use osc_par_m
   use point_m
   use state_m

   use ISO_FORTRAN_ENV

   ! No implicit typing

   implicit none (type, external)

   ! Derived-type definitions

   type, extends(bound_conds_ct) :: ${P}$_nad_obound_conds_t
      private
      type(context_t), pointer  :: cx => null()
      real(RD)                  :: V_2
      real(RD)                  :: V
      real(RD)                  :: V_g
      real(RD)                  :: As
      real(RD)                  :: U
      real(RD)                  :: c_1
      real(RD)                  :: nabla_ad
      real(RD)                  :: c_thn
      real(RD)                  :: ups_T
      real(RD)                  :: Omega_rot
      character(:), allocatable :: branch
      procedure(eval_), pointer :: eval_
   contains
      private
      procedure, public :: eval
   end type ${P}$_nad_obound_conds_t

   ! Interfaces

   interface
      subroutine eval_(this, st, B, s, trans)
         use forum_m, only: RD
         use state_m
         import ${P}$_nad_obound_conds_t
         implicit none (type, external)
         class(${P}$_nad_obound_conds_t), intent(in)    :: this
         class(state_ct), intent(in)                    :: st
         complex(RD), contiguous, intent(out)           :: B(:,:)
         complex(RD), contiguous, intent(out), optional :: s(:)
         logical, intent(in), optional                  :: trans
      end subroutine eval_
   end interface

   interface ${P}$_nad_obound_conds_t
      module procedure ${P}$_nad_obound_conds_t_
   end interface ${P}$_nad_obound_conds_t

   ! Access specifiers

   public :: ${P}$_nad_obound_conds_t

   ! Default access

   private

contains

   function ${P}$_nad_obound_conds_t_(cx, os_p) result(bc)

      type(context_t), pointer, intent(in) :: cx
      type(osc_par_t), intent(in)          :: os_p
      type(${P}$_nad_obound_conds_t)       :: bc

      class(model_t), pointer :: ml
      type(point_t)           :: pt

      ! Construct the nad_obound_conds type

      ml => cx%model()
      pt = cx%point_o()

      select case (os_p%outer_bound)
      case ('VACUUM')
         bc%eval_ => eval_vacuum_
      case ('ZERO_R')
         bc%eval_ => eval_zero_r_
      case ('ZERO_H')
         bc%eval_ => eval_zero_h_
      case ('DZIEM')
         if (ml%is_vacuum(pt)) then
            bc%eval_ => eval_vacuum_
         else
            bc%eval_ => eval_dziem_
         end if
      case ('ISOTHERMAL')
         if (ml%is_vacuum(pt)) then
            bc%eval_ => eval_vacuum_
         else
            bc%eval_ => eval_decomp_
         end if
      case ('UNNO')
         if (ml%is_vacuum(pt)) then
            bc%eval_ => eval_vacuum_
         else
            bc%eval_ => eval_decomp_
         end if
      case ('JCD')
         if (ml%is_vacuum(pt)) then
            bc%eval_ => eval_vacuum_
         else
            bc%eval_ => eval_jcd_
         end if
      case default
         @:ABORT('invalid outer_bound')
      end select

      bc%cx => cx

      ! Store structure coefficients

      call check_model(ml, [I_V_2,I_U,I_C_1,I_GAMMA_1,I_NABLA_AD,I_C_THN,I_OMEGA_ROT])

      bc%V_2 = ml%coeff(I_V_2, pt)
      bc%V = bc%V_2*pt%x**2
      bc%U = ml%coeff(I_U, pt)

      bc%nabla_ad = ml%coeff(I_NABLA_AD, pt)
      bc%c_thn = ml%coeff(I_C_THN, pt)

      bc%Omega_rot = cx%Omega_rot(pt)

      select case (os_p%outer_bound)
      case ('VACUUM', 'ZERO_R', 'ZERO_H', 'DZIEM')
         bc%V_g = bc%V/ml%coeff(I_GAMMA_1, pt)
         bc%As = ml%coeff(I_AS, pt)
         bc%c_1 = ml%coeff(I_C_1, pt)
      case ('ISOTHERMAL')
         call eval_atmos_coeffs_isothrm(ml, pt, bc%V_g, &
            bc%As, bc%c_1)
      case ('UNNO')
         call eval_atmos_coeffs_unno(ml, pt, bc%V_g, &
            bc%As, bc%c_1)
      case ('JCD')
         call eval_atmos_coeffs_isothrm(ml, pt, bc%V_g, &
            bc%As, bc%c_1)
      case default
         @:ABORT('invalid outer_bound')
      end select

      ! Other initializations

      bc%branch = os_p%outer_bound_branch

      bc%n_e = 6
      bc%n_b = 3

      ! Finish

      return

   end function ${P}$_nad_obound_conds_t_

   !****

   subroutine eval(this, st, B, s, trans)

      class(${P}$_nad_obound_conds_t), intent(in)    :: this
      class(state_ct), intent(in)                    :: st
      complex(RD), contiguous, intent(out)           :: B(:,:)
      complex(RD), contiguous, intent(out), optional :: s(:)
      logical, intent(in), optional                  :: trans

      ! Evaluate the outer boundary conditions

      call this%eval_(st, B, s, trans)

      ! Finish

      return

   end subroutine eval

   !****

   subroutine eval_vacuum_(this, st, B, s, trans)

      class(${P}$_nad_obound_conds_t), intent(in)    :: this
      class(state_ct), intent(in)                    :: st
      complex(RD), contiguous, intent(out)           :: B(:,:)
      complex(RD), contiguous, intent(out), optional :: s(:)
      logical, intent(in), optional                  :: trans

      logical     :: trans_
      complex(RD) :: omega_c
      complex(RD) :: i_omega_c
      complex(RD) :: lambda
      complex(RD) :: l_e
      complex(RD) :: f_rht

      if (PRESENT(trans)) then
         trans_ = trans
      else
         trans_ = .FALSE.
      end if

      if (trans_) then
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_e)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_b)
      else
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_b)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_e)
      end if

      if (PRESENT(s)) then
         @:CHECK_BOUNDS(SIZE(s), this%n_b)
      end if

      ! Evaluate the outer boundary condition matrix and inhomogeneous
      ! vector (vacuum)

      associate( &
         omega => st%omega, &
         y_T_1 => st%y_T_1, &
         V_2 => this%V_2, &
         V => this%V, &
         U => this%U, &
         c_1 => this%c_1, &
         nabla_ad => this%nabla_ad, &
         c_thn => this%c_thn, &
         Omega_rot => this%Omega_rot, &
         alpha_grv => this%cx%alpha_grv, &
         alpha_gbc => this%cx%alpha_gbc, &
         alpha_rht => this%cx%alpha_rht, &
         alpha_omg => this%cx%alpha_omg, &
         m => this%cx%m)

         omega_c = omega - m*Omega_rot

         i_omega_c = (0._RD,1._RD)*sqrt(CMPLX(alpha_omg, KIND=RD))*omega_c

         lambda = this%cx%lambda(Omega_rot, st)
         l_e = this%cx%l_e(Omega_rot, st)

         f_rht = 1._RD - 0.25_RD*alpha_rht*i_omega_c*c_thn

         #:include 'OB_vacuum.inc'

      end associate

      ! Finish

      return

   end subroutine eval_vacuum_

   !****

   subroutine eval_zero_r_(this, st, B, s, trans)

      class(${P}$_nad_obound_conds_t), intent(in)    :: this
      class(state_ct), intent(in)                    :: st
      complex(RD), contiguous, intent(out)           :: B(:,:)
      complex(RD), contiguous, intent(out), optional :: s(:)
      logical, intent(in), optional                  :: trans

      logical     :: trans_
      complex(RD) :: omega_c
      complex(RD) :: i_omega_c
      complex(RD) :: lambda
      complex(RD) :: l_e
      complex(RD) :: f_rht

      if (PRESENT(trans)) then
         trans_ = trans
      else
         trans_ = .FALSE.
      end if

      if (trans_) then
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_e)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_b)
      else
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_b)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_e)
      end if

      if (PRESENT(s)) then
         @:CHECK_BOUNDS(SIZE(s), this%n_b)
      end if

      ! Evaluate the outer boundary condition matrix and inhomogeneous
      ! vector (zero radial displacement)

      associate( &
         omega => st%omega, &
         y_T_1 => st%y_T_1, &
         V_2 => this%V_2, &
         V => this%V, &
         U => this%U, &
         c_1 => this%c_1, &
         nabla_ad => this%nabla_ad, &
         c_thn => this%c_thn, &
         Omega_rot => this%Omega_rot, &
         alpha_grv => this%cx%alpha_grv, &
         alpha_gbc => this%cx%alpha_gbc, &
         alpha_rht => this%cx%alpha_rht, &
         alpha_omg => this%cx%alpha_omg, &
         m => this%cx%m)

         omega_c = omega - m*Omega_rot

         i_omega_c = (0._RD,1._RD)*sqrt(CMPLX(alpha_omg, KIND=RD))*omega_c

         lambda = this%cx%lambda(Omega_rot, st)
         l_e = this%cx%l_e(Omega_rot, st)

         f_rht = 1._RD - 0.25_RD*alpha_rht*i_omega_c*c_thn

         #:include 'OB_zero_r.inc'

      end associate

      ! Finish

      return

   end subroutine eval_zero_r_

   !****

   subroutine eval_zero_h_(this, st, B, s, trans)

      class(${P}$_nad_obound_conds_t), intent(in)    :: this
      class(state_ct), intent(in)                    :: st
      complex(RD), contiguous, intent(out)           :: B(:,:)
      complex(RD), contiguous, intent(out), optional :: s(:)
      logical, intent(in), optional                  :: trans

      logical     :: trans_
      complex(RD) :: omega_c
      complex(RD) :: i_omega_c
      complex(RD) :: l_e
