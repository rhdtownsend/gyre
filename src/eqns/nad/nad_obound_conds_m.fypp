   end subroutine eval_zero_h_

   !****

   subroutine eval_dziem_(this, st, B, s, trans)

      class(${P}$_nad_obound_conds_t), intent(in)    :: this
      class(state_ct), intent(in)                    :: st
      complex(RD), contiguous, intent(out)           :: B(:,:)
      complex(RD), contiguous, intent(out), optional :: s(:)
      logical, intent(in), optional                  :: trans

      logical     :: trans_
      complex(RD) :: omega_c
      complex(RD) :: i_omega_c
      complex(RD) :: lambda
      complex(RD) :: l_e
      complex(RD) :: f_rht

      if (PRESENT(trans)) then
         trans_ = trans
      else
         trans_ = .FALSE.
      end if

      if (trans_) then
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_e)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_b)
      else
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_b)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_e)
      end if

      if (PRESENT(s)) then
         @:CHECK_BOUNDS(SIZE(s), this%n_b)
      end if

      ! Evaluate the outer boundary condition matrix and inhomogeneous
      ! vector ([Dzi1971] formulation)

      associate( &
         omega => st%omega, &
         y_T_1 => st%y_T_1, &
         V_2 => this%V_2, &
         V => this%V, &
         U => this%U, &
         c_1 => this%c_1, &
         nabla_ad => this%nabla_ad, &
         c_thn => this%c_thn, &
         Omega_rot => this%Omega_rot, &
         alpha_grv => this%cx%alpha_grv, &
         alpha_gbc => this%cx%alpha_gbc, &
         alpha_rht => this%cx%alpha_rht, &
         alpha_omg => this%cx%alpha_omg, &
         m => this%cx%m)

         omega_c = omega - m*Omega_rot

         i_omega_c = (0._RD,1._RD)*sqrt(CMPLX(alpha_omg, KIND=RD))*omega_c

         lambda = this%cx%lambda(Omega_rot, st)
         l_e = this%cx%l_e(Omega_rot, st)

         f_rht = 1._RD - 0.25_RD*alpha_rht*i_omega_c*c_thn

         #:include 'OB_dziem.inc'

      end associate

      ! Finish

      return

   end subroutine eval_dziem_

   !****

   subroutine eval_decomp_(this, st, B, s, trans)

      class(${P}$_nad_obound_conds_t), intent(in)    :: this
      class(state_ct), intent(in)                    :: st
      complex(RD), contiguous, intent(out)           :: B(:,:)
      complex(RD), contiguous, intent(out), optional :: s(:)
      logical, intent(in), optional                  :: trans

      logical     :: trans_
      complex(RD) :: omega_c
      complex(RD) :: i_omega_c
      complex(RD) :: lambda
      complex(RD) :: l_e
      complex(RD) :: f_rht
      complex(RD) :: a_11
      complex(RD) :: a_12
      complex(RD) :: a_13
      complex(RD) :: a_14
      complex(RD) :: a_21
      complex(RD) :: a_22
      complex(RD) :: a_23
      complex(RD) :: a_24
      complex(RD) :: chi
      complex(RD) :: G_1
      complex(RD) :: G_2

      if (PRESENT(trans)) then
         trans_ = trans
      else
         trans_ = .FALSE.
      end if

      if (trans_) then
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_e)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_b)
      else
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_b)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_e)
      end if

      if (PRESENT(s)) then
         @:CHECK_BOUNDS(SIZE(s), this%n_b)
      end if

      ! Evaluate the outer boundary condition matrix and inhomogeneous
      ! vector, based on a local eigendecomposition

      associate( &
         omega => st%omega, &
         y_T_1 => st%y_T_1, &
         V_2 => this%V_2, &
         V => this%V, &
         V_g => this%V_g, &
         As => this%As, &
         U => this%U, &
         c_1 => this%c_1, &
         nabla_ad => this%nabla_ad, &
         c_thn => this%c_thn, &
         Omega_rot => this%Omega_rot, &
         branch => this%branch, &
         alpha_grv => this%cx%alpha_grv, &
         alpha_gbc => this%cx%alpha_gbc, &
         alpha_rht => this%cx%alpha_rht, &
         alpha_omg => this%cx%alpha_omg, &
         m => this%cx%m)

         omega_c = omega - m*Omega_rot

         i_omega_c = (0._RD,1._RD)*sqrt(CMPLX(alpha_omg, KIND=RD))*omega_c

         lambda = this%cx%lambda(Omega_rot, st)
         l_e = this%cx%l_e(Omega_rot, st)

         f_rht = 1._RD - 0.25_RD*alpha_rht*i_omega_c*c_thn

         ! Evaluate selected elements of the Jacobian matrix

         a_11 = V_g - 3._RD
         a_12 = lambda/(c_1*alpha_omg*omega_c**2) - V_g
         a_13 = alpha_grv*(lambda/(c_1*alpha_omg*omega_c**2))
         a_14 = alpha_grv*(0._RD)

         a_21 = c_1*alpha_omg*omega_c**2 - As
         a_22 = As + 1._RD
         a_23 = alpha_grv*(0._RD)
         a_24 = alpha_grv*(-1._RD)

         ! Evaluate the eigenvalue for the wave we want to keep

         chi = atmos_chi(V_g, As, c_1, alpha_omg, omega_c, lambda, branch)

         ! Evaluate selected elements of the left eigenvectors

         G_1 = (l_e*H_(-l_e, chi) + (l_e+1._RD)*H_(l_e+1._RD, chi))/(2._RD*l_e + 1._RD)
         G_2 = (H_(-l_e, chi) - H_(l_e+1._RD, chi))/(2._RD*l_e + 1._RD)

         ! Set up the matrix

         #:include 'OB_decomp.inc'

      end associate

      ! Finish

      return

   contains

      function H_(l, chi) result(H)

         complex(RD), intent(in) :: l
         complex(RD), intent(in) :: chi
         complex(RD)             :: H

         ! Evaluate the H function defined in leaky boundary condition
         ! notes

         H = ((a_11 - chi)*(a_13 - a_14*(1._RD-l)) + a_12*(a_23 - a_24*(1._RD-l))) / &
            (chi + l - a_11 - a_12)

         ! Finish

         return

      end function H_

   end subroutine eval_decomp_

   !****

   subroutine eval_jcd_(this, st, B, s, trans)

      class(${P}$_nad_obound_conds_t), intent(in)    :: this
      class(state_ct), intent(in)                    :: st
      complex(RD), contiguous, intent(out)           :: B(:,:)
      complex(RD), contiguous, intent(out), optional :: s(:)
      logical, intent(in), optional                  :: trans

      logical     :: trans_
      complex(RD) :: omega_c
      complex(RD) :: i_omega_c
      complex(RD) :: lambda
      complex(RD) :: l_e
      complex(RD) :: f_rht
      complex(RD) :: chi
      complex(RD) :: b_11
      complex(RD) :: b_12

      if (PRESENT(trans)) then
         trans_ = trans
      else
         trans_ = .FALSE.
      end if

      if (trans_) then
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_e)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_b)
      else
         @:CHECK_BOUNDS(SIZE(B, 1), this%n_b)
         @:CHECK_BOUNDS(SIZE(B, 2), this%n_e)
      end if

      if (PRESENT(s)) then
         @:CHECK_BOUNDS(SIZE(s), this%n_b)
      end if

      ! Evaluate the outer boundary condition matrix and inhomogeneous
      ! vector ([Chr2008] formulation)

      associate( &
         omega => st%omega, &
         y_T_1 => st%y_T_1, &
         V_2 => this%V_2, &
         V => this%V, &
         V_g => this%V_g, &
         As => this%As, &
         U => this%U, &
         c_1 => this%c_1, &
         nabla_ad => this%nabla_ad, &
         c_thn => this%c_thn, &
         Omega_rot => this%Omega_rot, &
         branch => this%branch, &
         alpha_grv => this%cx%alpha_grv, &
         alpha_gbc => this%cx%alpha_gbc, &
         alpha_rht => this%cx%alpha_rht, &
         alpha_omg => this%cx%alpha_omg, &
         m => this%cx%m)

         omega_c = omega - m*Omega_rot

         i_omega_c = (0._RD,1._RD)*sqrt(CMPLX(alpha_omg, KIND=RD))*omega_c

         lambda = this%cx%lambda(Omega_rot, st)
         l_e = this%cx%l_e(Omega_rot, st)

         f_rht = 1._RD - 0.25_RD*alpha_rht*i_omega_c*c_thn

         chi = atmos_chi(V_g, As, c_1, alpha_omg, omega_c, lambda, branch)

         b_11 = V_g - 3._RD
         b_12 = lambda/(c_1*alpha_omg*omega_c**2) - V_g

         #:include 'OB_jcd.inc'

      end associate

      ! Finish

      return

   end subroutine eval_jcd_

end module ${P}$_nad_obound_conds_m
