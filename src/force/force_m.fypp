#:include 'gyre.inc'

module force_m

   ! No implicit typing

   implicit none (type, external)

   #:for T, S in zip(DTYPE_BASE_TYPES, DTYPE_SUFFIXES)

      ! Derived-type definitions

      type, abstract :: force_${S}$
      contains
         procedure(eval_${S}$_), deferred :: eval
      end type force_${S}$

      ! Interfaces

      abstract interface

         subroutine eval_${S}$_(this, st, z, dz)
            use forum_m, only: RD
            use state_m
            import force_${S}$
            implicit none (type, external)
            class(force_${S}$), intent(in) :: this
            class(state_${S}$), intent(in) :: st
            ${T}$, intent(out)             :: z
            ${T}$, intent(out)             :: dz
         end subroutine eval_${S}$_

         subroutine force_${S}$_factory(pt, fr)
            use context_m
            use point_m
            import force_${S}$
            implicit none (type, external)
            type(point_t), intent(in)                    :: pt
            class(force_${S}$), allocatable, intent(out) :: fr
         end subroutine force_${S}$_factory

      end interface

      ! Access specifiers

      public :: force_${S}$
      public :: force_${S}$_factory

   #:endfor

   ! Default access

   private

end module force_m
